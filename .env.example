PORT=3002

# PostgreSQL — usado por la app
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=ms_users

# JWT — debe coincidir con ms-auth si se usa integración
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Cloudinary — fotos de perfil
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Gmail — envío de OTP para recuperar contraseña
GMAIL_USER=CHANGE_ME@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME

# ms-auth — sync directa de rol/estado (mismo valor que INTERNAL_API_KEY en ms-auth)
AUTH_URL=http://localhost:3001
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY

NODE_ENV=development

# Admin fijo (seed) — se crea automáticamente al iniciar si no existe
SEED_ADMIN_EMAIL=admin@sanosysalvos.cl
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_APELLIDO=Sistema
SEED_ADMIN_TELEFONO=+56900000000
SEED_ADMIN_REGION=RM
SEED_ADMIN_COMUNA=Santiago
SEED_ADMIN_RUN=99999999-9
SEED_ADMIN_DIRECCION=Dirección interna del sistema
